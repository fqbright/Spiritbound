[application]
config/name="Spiritbound"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7")

[display]
window/size/viewport_width=390
window/size/viewport_height=844
window/size/window_width_override=390
window/size/window_height_override=844
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.025, 0.067, 0.086, 1)

[audio]
driver/enable_input=false

[input]
ui_accept={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":4194309),Object(InputEventScreenTouch,"pressed":true)]}

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[gui]
theme/custom_font="res://assets/fonts/LXGWWenKai-Medium.ttf"

[debug]
gdscript/warnings/exclude_addons=true
file_logging/enable_file_logging=true

[editor_plugins]
enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[spiritbound]

; Billing plugin hand-off for the season-pass purchase gate (Docs/LAUNCH_READINESS.md §2).
; List the vendored plugin name(s) here and PurchaseService.bootstrap_provider() wires the first
; one that exists at startup — a native plugin singleton name (Engine.get_singleton(), how
; Godot StoreKit / Play Billing plugins register) or a GDScript `class_name` adapter over it.
; The provider must expose `purchase(product_id) -> Dictionary` (and optionally `restore()`).
; Empty is the correct value until a plugin is actually vendored: with no provider wired, Buy
; and Restore both fail closed and the premium track stays locked, which is the intended
; behavior for an unconfigured store.
purchase/provider_candidates=PackedStringArray()

